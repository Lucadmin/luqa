# --- Database (NeonDB) ---
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/luqa?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# --- Single-user lockdown ---
# Only these emails can sign in or create accounts. Comma-separate for future users.
APP_OWNER_EMAIL="luca.ilchen@gmail.com"
APP_ALLOWED_EMAILS="luca.ilchen@gmail.com"
# Production signup is disabled unless this is set. Temporarily set a strong
# value when you need to create an allowed account, then unset it again.
APP_SIGNUP_TOKEN=""
# Encrypts OAuth tokens stored in the database. Generate with:
# openssl rand -base64 32
# If omitted, AUTH_SECRET is used as the encryption root.
APP_ENCRYPTION_KEY=""

# --- Google Calendar integration (added later) ---
# OAuth client for the dedicated-calendar sync, separate from login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public base URL, used for OAuth redirects and calendar push webhooks.
APP_URL="https://your-app.vercel.app"
# Optional shared secret sent in the x-goog-channel-token header for Calendar
# push notifications. If set, reconnect Google Calendar so watches include it.
GOOGLE_WEBHOOK_TOKEN=""

# --- Google Health integration (RETIRED) ---
# Superseded by on-device Android Health Connect; see docs/sleep-integration.md.
# No live code path reads these. Kept so an existing deployment keeps parsing.
# Optional separate OAuth client for Google Health API. If omitted, the app
# falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
GOOGLE_HEALTH_CLIENT_ID=""
GOOGLE_HEALTH_CLIENT_SECRET=""
# Optional shared secret for Google Health webhooks. Configure the webhook URL
# as /api/health/google/webhook?token=<value> if Google cannot send headers.
GOOGLE_HEALTH_WEBHOOK_TOKEN=""
