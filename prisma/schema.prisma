// Luqa time tracker — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A registered user. Auth is email + password (credentials).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Preferences
  dayStartHour     Int @default(3) // logical day flips at this hour (0–23)
  dailyGoalMinutes Int @default(480) // tracked-time goal per day, for the reports goal line
  weekStartsOn     Int @default(1) // 0 = Sunday, 1 = Monday

  // Life overview ("life in weeks")
  birthDate           DateTime? @db.Date // anchors the life grid; null until set
  lifeExpectancyYears Int       @default(90) // number of year-rows the grid shows

  // Shared expenses
  currency String @default("EUR") // ISO 4217, used to format every amount

  categories             Category[]
  timeEntries            TimeEntry[]
  sleepEntries           SleepEntry[]
  healthSamples          HealthSample[]
  healthSyncStates       HealthSyncState[]
  googleConnection       GoogleConnection?
  googleHealthConnection GoogleHealthConnection?
  habits                 Habit[]
  lifePeriods            LifePeriod[]
  weekNotes              WeekNote[]
  people                 Person[]
  personGroups           PersonGroup[]
  expenses               Expense[]
  settlements            Settlement[]
  gymLocations           GymLocation[]
  exercises              Exercise[]
  gymSessions            GymSession[]
  mobileSessions         MobileSession[]

  @@map("users")
}

// Revocable native-app session. Tokens are random opaque credentials; only
// their SHA-256 hashes are persisted. One installation owns one active session
// per user, and refresh rotates both credentials.
model MobileSession {
  id               String    @id @default(cuid())
  userId           String
  deviceId         String
  deviceName       String?
  accessTokenHash  String    @unique
  accessExpiresAt  DateTime
  refreshTokenHash String    @unique
  refreshExpiresAt DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([refreshExpiresAt])
  @@map("mobile_sessions")
}

// A category / "project" in Toggl terms. The list grows as the user works.
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366f1") // hex, shown as the project dot
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set instead of removing the row, so a phone that syncs later can
  /// be told the thing is gone. Filtered out of every ordinary read.
  deletedAt DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  habits      Habit[]

  // A user can't have two categories with the same name.
  @@unique([userId, name])
  @@index([userId])
  @@index([userId, updatedAt])
  @@map("categories")
}

// Where an entry originated / where it currently lives in sync terms.
enum EntrySource {
  APP // created in the Luqa UI
  GOOGLE // created from a Google Calendar event
}

// Where a health record came from. Shared by every health domain — sleep today,
// samples (steps, heart rate, body metrics) as they are switched on — so adding a
// metric never means adding another source enum.
enum HealthSource {
  HEALTH_CONNECT // Android Health Connect, including Samsung Health data shared there
  APPLE_HEALTH // iOS HealthKit, for when the iOS client lands
  GOOGLE_HEALTH // Google Health API. Deprecated: superseded by on-device Health Connect.
  MANUAL // created or imported without a device provider
}

// A scalar or interval measurement from a health provider. Sleep keeps its own
// table because a session carries stage structure; everything else is one row per
// sample, so enabling a new metric is an enum value plus a client descriptor.
enum HealthMetricType {
  SLEEP // sync bookkeeping only; sessions live in sleep_entries, never health_samples
  STEPS // count over the interval
  DISTANCE_METERS
  ACTIVE_ENERGY_KCAL
  TOTAL_ENERGY_KCAL
  EXERCISE_MINUTES
  HEART_RATE_BPM
  RESTING_HEART_RATE_BPM
  HEART_RATE_VARIABILITY_MS
  RESPIRATORY_RATE_BPM
  BLOOD_OXYGEN_PERCENT
  BODY_TEMPERATURE_C
  WEIGHT_KG
  BODY_FAT_PERCENT
  VO2_MAX
}

// One tracked block of time. endTime is null while a timer is running.
model TimeEntry {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String?
  description String    @default("")
  startTime   DateTime
  endTime     DateTime? // null => currently running
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Google Calendar sync metadata
  source        EntrySource @default(APP)
  googleEventId String? // id of the mirrored event in the dedicated calendar
  googleEtag    String? // last-seen etag, for conflict detection
  lastSyncedAt  DateTime?
  deletedAt     DateTime? // soft delete so deletions can propagate to Google

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  people   TimeEntryPerson[]

  @@unique([userId, googleEventId])
  @@index([userId, startTime])
  @@index([userId, endTime])
  @@map("time_entries")
}

// Who was there.
//
// The point of tagging a block of time with people is that "last seen" stops
// being something anyone has to type. Dinner logged on Tuesday is the record
// that Tuesday is when you last saw them; asking the user to also tick a box
// on their contact card is asking twice for one fact.
model TimeEntryPerson {
  timeEntryId String
  personId    String

  entry  TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  person Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([timeEntryId, personId])
  @@index([personId])
  @@map("time_entry_people")
}

// A sleep session imported from a health provider. It is intentionally separate
// from TimeEntry so work/activity reports do not count sleep as tracked time.
model SleepEntry {
  id         String       @id @default(cuid())
  userId     String
  source     HealthSource
  externalId String

  title     String?
  notes     String?
  sourceApp String?
  startTime DateTime
  endTime   DateTime

  // Provider timezone offsets, if supplied.
  startZoneOffset String?
  endZoneOffset   String?

  // Stage totals in minutes. Null means the provider did not report the stage at
  // all, which is different from reporting zero. Health Connect distinguishes
  // awake-in-bed from out-of-bed; both used to collapse into awakeMinutes.
  sleepMinutes      Int? // total asleep: light + deep + rem + unspecified asleep
  awakeMinutes      Int? // awake inside the session
  awakeInBedMinutes Int?
  outOfBedMinutes   Int?
  lightMinutes      Int?
  deepMinutes       Int?
  remMinutes        Int?
  unknownMinutes    Int? // staged time the provider could not classify

  // Quality metrics derived from the stage timeline on import, so reports and
  // both clients read the same numbers instead of each recomputing them.
  inBedMinutes      Int? // wall-clock session length
  efficiencyPercent Float? // asleep / in-bed, 0–100
  latencyMinutes    Int? // session start until the first asleep stage
  wasoMinutes       Int? // wake after sleep onset, before the final wake
  awakeningCount    Int? // distinct awake blocks after sleep onset
  midpoint          DateTime? // midpoint of the asleep span, for chronotype drift

  isNap           Boolean @default(false)
  recordingMethod String? // AUTOMATICALLY_RECORDED | ACTIVELY_RECORDED | MANUAL_ENTRY | UNKNOWN
  deviceModel     String?

  stages Json?
  raw    Json?

  lastSyncedAt     DateTime?
  manualOverrideAt DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, endTime])
  @@index([userId, startTime])
  @@map("sleep_entries")
}

// One measurement from a health provider. Deliberately shaped like SleepEntry —
// same identity, soft-delete, and manual-override rules — so the ingest pipeline
// treats sleep sessions and samples the same way.
model HealthSample {
  id         String           @id @default(cuid())
  userId     String
  source     HealthSource
  metric     HealthMetricType
  externalId String

  // Instant measurements set both to the same time; interval metrics (steps,
  // energy) span the bucket the provider aggregated over.
  startTime DateTime
  endTime   DateTime

  value      Float
  sourceApp  String?
  zoneOffset String?
  raw        Json?

  lastSyncedAt     DateTime?
  manualOverrideAt DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, metric, externalId])
  @@index([userId, metric, startTime])
  @@index([userId, metric, endTime])
  @@map("health_samples")
}

// Per-user, per-source, per-metric sync bookkeeping. The Health Connect changes
// token itself is device-local, so this records what the server last accepted —
// enough to show "last synced" and to decide when a full backfill is due.
model HealthSyncState {
  id     String           @id @default(cuid())
  userId String
  source HealthSource
  metric HealthMetricType // SLEEP tracks the sleep_entries domain

  lastSyncedAt   DateTime?
  lastEntryAt    DateTime? // newest record timestamp accepted so far
  lastDeviceId   String? // which device last pushed, for multi-device debugging
  backfilledFrom DateTime? // oldest point a full read has covered

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, metric])
  @@map("health_sync_states")
}

// A user's connection to Google Calendar (separate OAuth from login).
// Holds tokens + the dedicated "Luqa" calendar id and incremental sync state.
model GoogleConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  googleEmail  String?
  accessToken  String
  refreshToken String
  expiresAt    DateTime // access token expiry
  scope        String

  calendarId String? // id of the dedicated Luqa calendar
  syncToken  String? // Google incremental sync token (nextSyncToken)

  // Push-notification channel (calendar watch), so Google can ping us on change
  channelId     String?
  resourceId    String?
  channelExpiry DateTime?

  lastSyncedAt DateTime? // set after each successful pull

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_connections")
}

// OAuth tokens for the Google Health API. Kept separate from Google Calendar
// because the scopes, approval process, and sync lifecycle are different.
model GoogleHealthConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  googleEmail  String?
  healthUserId String?
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_health_connections")
}

// What "done" means for a habit on a given day.
enum HabitGoalType {
  TASK // simple done / not done
  COUNT // reach a target number of reps (e.g. 3× water)
  TIME // accumulate a target duration (e.g. 2h focus)
}

// Whether a TIME habit's target is a daily quota or a period (week/month) total.
enum HabitGoalPeriod {
  DAY // target applies per day (default)
  WEEK // target is the cumulative total for the week
  MONTH // target is the cumulative total for the month
}

// How a habit recurs. Mirrors the options in the create flow.
enum HabitScheduleType {
  DAILY // every day
  WEEKDAYS // specific days of the week, optionally every N weeks
  INTERVAL // every N days from an anchor date
  TIMES_PER_WEEK // a quota of completions within each week
  TIMES_PER_MONTH // a quota within each calendar month
  TIMES_PER_YEAR // a quota within each calendar year
  DATES // specific calendar dates only
}

// A habit the user wants to keep up. Goal + schedule together decide what
// shows on a given day and what counts as "done".
model Habit {
  id         String    @id @default(cuid())
  userId     String
  name       String
  icon       String? // lucide icon name, e.g. "dumbbell"
  color      String    @default("#f5c451")
  order      Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Goal
  goalType      HabitGoalType   @default(TASK)
  goalPeriod    HabitGoalPeriod @default(DAY) // TIME only: DAY = daily, WEEK/MONTH = cumulative
  targetCount   Int             @default(1) // COUNT: reps needed; TASK: always 1
  targetSeconds Int             @default(0) // TIME: duration goal in seconds (or period total)

  // Optional link to a tracking category. When set on a TIME habit, its
  // progress is derived from time tracked on that category, and its timer
  // creates real time entries.
  categoryId String?

  // Schedule
  scheduleType   HabitScheduleType @default(DAILY)
  weekdays       Int[] // WEEKDAYS: 0=Sun … 6=Sat
  weekInterval   Int               @default(1) // WEEKDAYS: every N weeks
  intervalDays   Int               @default(2) // INTERVAL: every N days
  // INTERVAL only. False counts from `anchorDate` on a fixed grid; true counts
  // from the last day the goal was actually met, so missing a turn shifts every
  // turn after it instead of leaving the habit permanently off its own cycle.
  intervalFromLastDone Boolean @default(false)
  timesPerPeriod Int               @default(3) // TIMES_PER_*: quota per period
  anchorDate     String? // INTERVAL anchor, "YYYY-MM-DD"
  dates          String[] // DATES: explicit "YYYY-MM-DD" list
  excludedDates  String[] // any schedule: dates to skip

  logs     HabitLog[]
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([categoryId])
  @@map("habits")
}

// A named chapter of life shown as a coloured band on the life grid — e.g.
// "University", "Relationship with …", a job. Periods may overlap freely, so a
// relationship that spans university is represented by two overlapping periods.
model LifePeriod {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String    @default("#6366f1") // hex swatch shown on the grid + legend
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date // null => ongoing
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("life_periods")
}

// A weekly review attached to one age-week of the user's life. weekIndex is the
// 0-based number of weeks since birth (week 0 = the week they were born), so
// notes stay put even if the grid's life-expectancy changes.
model WeekNote {
  id         String   @id @default(cuid())
  userId     String
  weekIndex  Int
  highlights String   @default("") // accomplishments / wins
  lessons    String   @default("") // retrospective / what was learned
  rating     Int? // optional 1–5 self-rating for the week
  milestone  String? // optional one-off marker title; draws a dot on the grid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekIndex])
  @@index([userId])
  @@map("week_notes")
}

// --- Shared expenses ---------------------------------------------------------
//
// Everything here is expressed from the user's point of view: a positive
// balance means "this person owes me". Amounts are integer cents so no split
// ever loses a cent to floating point.

// Someone the user shares expenses with.
model Person {
  id     String  @id @default(cuid())
  userId String
  name   String
  color  String  @default("#6366f1")
  emoji  String? // optional glyph on the avatar, e.g. "🧡"

  // The everyday default: the cut of a bill this person carries, in percent.
  // Null means "share equally with everyone else on the expense", which is the
  // right answer for most people. Set it for the ones who differ — a flatmate
  // who always takes 30%, a sibling you always cover at 0%.
  defaultPercent Int?

  order      Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Set instead of removing the row, so a phone that syncs later can
  /// be told the thing is gone. Filtered out of every ordinary read.
  deletedAt DateTime?

  // --- Profile ---------------------------------------------------------
  //
  // Everything below is optional. Somebody who has only ever appeared on a
  // restaurant bill is a complete Person; the record accumulates if and when
  // it is worth writing down.

  nickname String? // what they are actually called, when it differs
  photoUrl String?

  // Stored as parts rather than a DateTime. Most contacts carry a day and a
  // month and no year, and forcing a year in means inventing one — which then
  // shows up as a confidently wrong age. Missing is simply missing.
  birthdayYear  Int?
  birthdayMonth Int?
  birthdayDay   Int?

  // How often being in touch is worth aiming for. Null for most people, and
  // null means they never appear in an overdue list.
  cadenceDays Int?

  // The last time they were actually seen.
  lastSeenAt DateTime?

  // The People API resource this row is linked to, e.g. "people/c1234". Null
  // for someone who exists only in Luqa. Written by the contacts sync, which
  // is additive: Luqa never deletes a Google contact or drops a field it did
  // not add.
  googleResourceName String?
  googleEtag         String?
  googleSyncedAt     DateTime?

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships  GroupMember[]
  shares       ExpenseShare[]
  paidExpenses Expense[]      @relation("ExpensePayer")
  settlements  Settlement[]
  places       PersonPlace[]
  channels     PersonChannel[]
  notes        PersonNote[]
  gifts        PersonGiftIdea[]
  timeEntries  TimeEntryPerson[]

  @@unique([userId, name])
  @@unique([userId, googleResourceName])
  @@index([userId])
  @@index([userId, updatedAt])
  @@map("people")
}

// Where a place came from, so a contacts sync knows what it may overwrite.
enum PlaceSource {
  GOOGLE
  MANUAL
}

enum ChannelKind {
  PHONE
  EMAIL
  HANDLE
}

// The child rows below are deliberately NOT their own sync collections. They
// ride inside PersonDTO the way group members ride inside PersonGroupDTO and
// shares ride inside ExpenseDTO: one row is one whole profile, which buys no
// new cursors and no new tombstone handling for four small tables.
//
// That costs one invariant, and it is the one rule that will silently break
// the feature if it is missed: every write to a child row must bump the parent
// Person's `updatedAt` in the same transaction. The delta feed orders by
// `updatedAt`, so a note added without touching the parent is a note no phone
// ever hears about. `touchPerson` in src/lib/server/people.ts is the only
// sanctioned way to write these, and it has its own test.

// A city name already resolved to a point, so it is only ever looked up once.
//
// Not per user: "Munich, DE" is the same place for everybody, and the cache is
// what keeps a rate-limited public geocoder viable at all. Nothing in here is
// personal — it is a city name and its centroid, which is also why sending it
// to a third-party geocoder is acceptable when sending a friend's street
// address would not be.
model GeocodeCache {
  // The normalised query, e.g. "munich|de". The primary key, because the whole
  // point is that one lookup answers every future one.
  query String @id

  latitude  Float?
  longitude Float?

  // The canonical names the geocoder gave back, which are usually tidier than
  // what was typed.
  city    String?
  country String?

  // A lookup that found nothing is cached too, with null coordinates. Without
  // this a misspelt city is retried on every sync for ever.
  resolvedAt DateTime @default(now())

  @@map("geocode_cache")
}

// A settlement the geocoder knows about, kept so that choosing one costs
// nothing to write down and nothing to read back.
//
// Not per user, for the same reason `geocode_cache` is not: a city is the same
// city whoever asked, and nothing in here is personal. The search endpoint
// fills this in as a side effect of answering, which is what lets adding a
// place resolve its city from the database instead of from the network.
model GeoCity {
  // GeoNames' id, not one of ours. It is stable, it is what the source data is
  // keyed by, and a place that stores it can be grouped with every other place
  // in the same city without comparing strings.
  geonameId Int @id

  name String
  // The first-level administrative area — state, province, Land. The single
  // most useful field for telling two cities of the same name apart.
  admin1      String?
  country     String?
  countryCode String?

  latitude  Float
  longitude Float

  // The IANA zone, e.g. "Europe/Berlin". Free with every result and the
  // obvious basis for saying what time it is where somebody is.
  timezone String?

  // Population and feature code are how a bare name that nobody picked from a
  // list is resolved: the biggest settlement wins, capitals break ties.
  population  Int?
  featureCode String?

  fetchedAt DateTime @default(now())

  @@map("geo_cities")
}

// What a search-as-you-type query answered with, so the second person to type
// "cam" is answered from here.
model GeoSearch {
  // The normalised query, e.g. "cambridge".
  query String @id

  // The matching cities, best first, as `GeoCity.geonameId`s. Order is the
  // geocoder's ranking and is worth keeping: it is better than ours.
  geonameIds Int[]

  searchedAt DateTime @default(now())

  @@map("geo_searches")
}

// Somewhere a person can be found.
//
// City-level on purpose. "I am in Hamburg on Thursday, who is here" is
// answered exactly as well by the city as by the street, while keeping a
// record of friends' addresses from becoming a map of friends' front doors:
// only the city centroid is ever geocoded and stored.
model PersonPlace {
  id       String @id @default(cuid())
  personId String

  label   String // "Home", "Parents", "Summer"
  city    String
  region  String?
  country String?

  // The city that was chosen, as a `GeoCity.geonameId`. Set when the owner
  // picked it from the search list, which is the normal path and the one that
  // decides between the two Cambridges. Null for a city that was only typed —
  // offline, or imported from a contact book — which is the row the geocoding
  // batch is for. No relation on purpose: `geo_cities` is a cache, and a place
  // must not stop existing because a cache row was pruned.
  cityId Int?

  // The IANA zone of that city, e.g. "Europe/Berlin".
  timezone String?

  // The address as the contact book had it, kept for reference. Never the
  // thing that gets plotted.
  address String?

  // The city centroid, once geocoded. Null until then: a place that lists but
  // does not yet pin. A place added through the picker has it from the start.
  latitude  Float?
  longitude Float?

  isPrimary Boolean     @default(false)
  source    PlaceSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("person_places")
}

// A way to reach someone.
model PersonChannel {
  id       String @id @default(cuid())
  personId String

  kind  ChannelKind
  label String? // "Mobile", "Work", "Signal"
  value String

  source PlaceSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("person_channels")
}

// Something worth remembering about a person.
//
// A dated list rather than one text field, because the useful thing is usually
// "what was going on with them last time", and a single blob loses that the
// moment it is edited.
model PersonNote {
  id       String @id @default(cuid())
  personId String

  body String

  // Kept at the top: the allergy, the kids' names, the thing not to bring up.
  pinned Boolean @default(false)

  // "YYYY-MM-DD" when the note is about a moment rather than a standing fact.
  happenedOn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("person_notes")
}

// Something to give them, and whether it has been given.
model PersonGiftIdea {
  id       String @id @default(cuid())
  personId String

  idea String
  url  String?

  // Set once it has actually been given. Kept rather than deleted, because the
  // list's second job is not giving the same thing twice.
  givenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("person_gift_ideas")
}

// A named set of people — the friend group, the flat, a trip. Picking one on an
// expense pre-selects its members; balances stay strictly per person.
model PersonGroup {
  id         String    @id @default(cuid())
  userId     String
  name       String
  color      String    @default("#6366f1")
  emoji      String?
  order      Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Set instead of removing the row, so a phone that syncs later can
  /// be told the thing is gone. Filtered out of every ordinary read.
  deletedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  expenses Expense[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, updatedAt])
  @@map("person_groups")
}

model GroupMember {
  groupId  String
  personId String

  group  PersonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([groupId, personId])
  @@index([personId])
  @@map("group_members")
}

// How the per-person shares of an expense were arrived at. Stored so reopening
// an expense shows the same editor state it was saved with.
enum SplitMode {
  EQUAL // everyone on the expense carries the same amount
  PERCENT // explicit percentages
  AMOUNT // explicit amounts typed per person
}

// One bill. The user's own slice lives on the expense (myShareCents); every
// other participant's slice is an ExpenseShare row.
model Expense {
  id          String @id @default(cuid())
  userId      String
  description String @default("")
  amountCents Int

  date DateTime @db.Date

  // Who fronted the money. Null = the user paid, which is the common case.
  // When someone else paid, only the user's own share moves a balance: what
  // the others owe in that case is between them and the payer.
  paidByPersonId String?

  groupId   String?
  splitMode SplitMode @default(EQUAL)

  // The user's own slice, in cents. Shares + myShareCents == amountCents.
  myShareCents Int    @default(0)
  notes        String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set instead of removing the row, so a phone that syncs later can
  /// be told the thing is gone. Filtered out of every ordinary read.
  deletedAt DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payer  Person?        @relation("ExpensePayer", fields: [paidByPersonId], references: [id], onDelete: Cascade)
  group  PersonGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  shares ExpenseShare[]

  @@index([userId, date])
  @@index([groupId])
  @@index([userId, updatedAt])
  @@map("expenses")
}

// What one participant carries on one expense.
model ExpenseShare {
  id          String @id @default(cuid())
  expenseId   String
  personId    String
  amountCents Int

  // What this slice is as a percentage of the bill, in basis points
  // (10000 = 100%): the figure that was typed in PERCENT mode, derived from
  // the amount otherwise. Null only on a zero-amount bill.
  percentBp Int?

  // A treat: the user covered this slice as a gift. The amount is still
  // recorded and totalled per person, but it never becomes a debt.
  gifted Boolean @default(false)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([expenseId, personId])
  @@index([personId])
  @@map("expense_shares")
}

// Which way the money moved when a debt was paid off.
enum SettlementDirection {
  TO_ME // they paid the user back
  FROM_ME // the user paid them
}

// A payback. Settles part or all of a person's balance without touching the
// expenses it came from.
model Settlement {
  id          String              @id @default(cuid())
  userId      String
  personId    String
  amountCents Int
  direction   SettlementDirection @default(TO_ME)
  date        DateTime            @db.Date
  notes       String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  /// Set instead of removing the row, so a phone that syncs later can
  /// be told the thing is gone. Filtered out of every ordinary read.
  deletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([personId])
  @@index([userId, updatedAt])
  @@map("settlements")
}

// Progress for one habit on one logical day. Created lazily on first interaction.
model HabitLog {
  id           String    @id @default(cuid())
  habitId      String
  date         String // "YYYY-MM-DD" logical day in the user's timezone
  count        Int       @default(0) // COUNT progress; TASK: 0 or 1
  seconds      Int       @default(0) // TIME (unlinked) accumulated seconds
  runningSince DateTime? // TIME (unlinked): timer running since this instant
  completedAt  DateTime? // first moment the goal was met (for streaks)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  // The delta feed walks logs by when they last changed — for the whole
  // account, and for one habit at a time.
  @@index([updatedAt])
  @@index([habitId, updatedAt])
  @@map("habit_logs")
}

// --- Gym log -----------------------------------------------------------------
//
// Modelled on how the user already writes their notes: a session is a date, a
// gym, and a list of exercises, each with one free-text line of sets. That line
// is kept verbatim in `raw` and *also* parsed into GymSet rows, so nothing the
// user types is ever rejected or lost — the parse is a bonus that powers the
// history graphs, not a gate on saving.

// One gym. `code` is the short form used while logging ("STR"); `name` is what
// it expands to on screen.
model GymLocation {
  id         String    @id @default(cuid())
  userId     String
  code       String
  name       String
  color      String    @default("#6366f1")
  order      Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Set instead of removing the row, so a phone that syncs later can
  /// be told the thing is gone. Filtered out of every ordinary read.
  deletedAt DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions GymSession[]

  @@unique([userId, code])
  @@index([userId])
  @@index([userId, updatedAt])
  @@map("gym_locations")
}

// A movement, identified by whatever the user calls it. The list grows as they
// log; the picker offers it back so spelling stays consistent over the years.
model Exercise {
  id           String    @id @default(cuid())
  userId       String
  name         String
  notes        String    @default("") // standing cues, e.g. "Sitz 4, Griff eng"
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  mergedIntoId String?

  /// Set instead of removing the row, so a phone that syncs later can
  /// be told the thing is gone. Filtered out of every ordinary read.
  deletedAt DateTime?

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       SessionExercise[]
  mergedInto    Exercise?         @relation("ExerciseMergeRedirect", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedSources Exercise[]        @relation("ExerciseMergeRedirect")

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([mergedIntoId])
  @@map("exercises")
}

// One visit to the gym.
model GymSession {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  locationId String?
  notes      String   @default("") // how the whole session felt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// When the user stopped training. Null means the workout is still open,
  /// which is what makes the Gym tab offer to continue it. Set by finishing
  /// the workout by hand, or stamped with the last edit's time once a session
  /// has sat untouched long enough to have plainly been abandoned.
  endedAt DateTime?

  /// Set instead of removing the row, so a phone that syncs later can
  /// be told the thing is gone. Filtered out of every ordinary read.
  deletedAt DateTime?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  location  GymLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  exercises SessionExercise[]

  @@index([userId, date])
  @@index([locationId])
  @@index([userId, updatedAt])
  @@map("gym_sessions")
}

// One exercise as performed in one session.
model SessionExercise {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  order      Int      @default(0)
  raw        String   @default("") // the sets line exactly as typed
  notes      String   @default("") // "Bizeps kaputt", "nimm nächstes Mal 20"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  GymSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets     GymSet[]

  @@index([sessionId])
  @@index([exerciseId])
  @@map("session_exercises")
}

// One set, parsed out of the raw line. Both fields are nullable because plenty
// of real entries only have one of them — bodyweight pull-ups record reps, a
// note-only line records neither.
model GymSet {
  id                String  @id @default(cuid())
  sessionExerciseId String
  order             Int     @default(0)
  weight            Float? // as typed; unit is whatever that gym's stack says
  reps              Int?
  note              String? // per-set marker, e.g. "lf" / "rf"

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId])
  @@map("gym_sets")
}
